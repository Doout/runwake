# syntax=docker/dockerfile:1.7
ARG GO_IMAGE=golang:1.26-alpine
ARG ALPINE_IMAGE=alpine:3.24

FROM ${GO_IMAGE} AS build
WORKDIR /src
COPY go.mod ./
COPY cmd ./cmd
COPY internal ./internal
ARG VERSION=0.1.0
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath \
    -ldflags="-s -w -X github.com/Doout/runwake/internal/agent.Version=${VERSION}" \
    -o /out/runwake-agent ./cmd/runwake-agent

FROM ${ALPINE_IMAGE}
RUN apk add --no-cache ca-certificates tzdata \
    && addgroup -S -g 65532 runwake \
    && adduser -S -D -H -u 65532 -G runwake runwake
COPY --from=build /out/runwake-agent /usr/local/bin/runwake-agent
USER 65532:65532
ENTRYPOINT ["runwake-agent"]
